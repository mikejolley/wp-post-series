{
	"name": "wp-post-series",
	"title": "WP Post Series",
	"homepage": "https://wordpress.org/plugins/wp-post-series",
	"description": "Lets you setup a simple series of posts using taxonomies. Posts within a series will show an information box above the content automatically with links to other posts in the series and a description.",
	"author": "Mike Jolley",
	"license": "GPL-3.0-or-later",
	"version": "2.1.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mikejolley/wp-post-series.git"
	},
	"bugs": {
		"url": "https://github.com/mikejolley/wp-post-series/issues"
	},
	"devDependencies": {
		"@wordpress/api-fetch": "^7.56.0",
		"@wordpress/block-editor": "^18.0.0",
		"@wordpress/blocks": "^16.1.0",
		"@wordpress/components": "^41.0.0",
		"@wordpress/data": "^10.56.0",
		"@wordpress/element": "^8.8.0",
		"@wordpress/i18n": "^6.29.0",
		"@wordpress/scripts": "^36.0.0",
		"@wordpress/server-side-render": "^6.32.0"
	},
	"scripts": {
		"build": "wp-scripts build --webpack-src-dir=assets/js",
		"start": "wp-scripts start --webpack-src-dir=assets/js",
		"format": "wp-scripts format",
		"lint:js": "wp-scripts lint-js assets/js",
		"lint:css": "wp-scripts lint-style \"assets/**/*.scss\"",
		"lint:php": "composer run-script phpcs",
		"lint": "npm run lint:js && npm run lint:css && npm run lint:php",
		"plugin-zip": "wp-scripts plugin-zip"
	},
	"dependencies": {
		"@wordpress/icons": "^17.0.0"
	}
}
